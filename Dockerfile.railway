# UltraBoost Dashboard - Railway Deployment
# Powered by BoostNova

FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y build-essential curl && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Railway provides PORT as an environment variable
# Default to 8501 if not set
ENV PORT=8501

EXPOSE ${PORT}

# Use shell form so environment variables are expanded at runtime
CMD streamlit run main.py --server.port=${PORT} --server.address=0.0.0.0 --server.headless=true
